<div style="font-family: sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <h2 style="color: #1a1a2e;">ChainSettle Weekly Admin Summary</h2>
  <p>Here is your platform performance summary for the week of {{periodStart}} to {{periodEnd}}.</p>
  
  <table style="width: 100%; border-collapse: collapse; margin-top: 16px;">
    <thead>
      <tr style="background-color: #f4f5f7; text-align: left;">
        <th style="padding: 10px; border: 1px solid #e1e4e8;">Metric</th>
        <th style="padding: 10px; border: 1px solid #e1e4e8;">Current Week</th>
        <th style="padding: 10px; border: 1px solid #e1e4e8;">Previous Week</th>
        <th style="padding: 10px; border: 1px solid #e1e4e8;">Change (%)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">New Users</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newUsers.current}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newUsers.previous}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newUsers.changePct}}%</td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">New Shipments</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newShipments.current}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newShipments.previous}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.newShipments.changePct}}%</td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">Total Volume (USD)</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">${{metrics.totalVolumeUsd.current}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">${{metrics.totalVolumeUsd.previous}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.totalVolumeUsd.changePct}}%</td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">Disputes Raised</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.disputes.current}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.disputes.previous}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.disputes.changePct}}%</td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">DLQ Size (Failed Events)</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.dlqSize.current}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.dlqSize.previous}}</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.dlqSize.changePct}}%</td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">Webhook Failure Rate</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.webhookFailureRate.current}}%</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.webhookFailureRate.previous}}%</td>
        <td style="padding: 10px; border: 1px solid #e1e4e8;">{{metrics.webhookFailureRate.changePct}}%</td>
      </tr>
    </tbody>
  </table>

  <hr style="margin-top: 24px; border: 0; border-top: 1px solid #eee;" />
  <small style="color: #888;">You are receiving this automated email as an Admin user on ChainSettle. You can opt out in your notification preferences.</small>
</div>
